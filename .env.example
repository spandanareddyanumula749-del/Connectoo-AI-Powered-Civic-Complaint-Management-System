# ==============================================================================
# Connectoo Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Application
PROJECT_NAME="Connectoo – AI-Powered Civic Management System"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-production-key-change-this-in-production-environments"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Frontend URL (Used for verification and reset password links)
FRONTEND_URL="http://localhost:5173"

# Database Configuration
# Local Development SQLite (Default zero-config):
DATABASE_URL="sqlite:///./connectoo.db"

# Production PostgreSQL:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/connectoo"

# File Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=15

# CORS Origins (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:5174","http://127.0.0.1:3000"]

# ==============================================================================
# Email & SMTP Delivery Configuration
# When SMTP_HOST is unset, verification & reset links are securely printed to the server terminal.
# ==============================================================================
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-specific-password"
# SMTP_FROM_EMAIL="noreply@connectoo.gov"
# SMTP_FROM_NAME="Connectoo Municipal Platform"
# SMTP_TLS=true

# Email Verification Policy
# Set to 'true' to require email verification before citizen login. Set to 'false' to allow instant login.
REQUIRE_EMAIL_VERIFICATION=true

# Optional External AI Provider (Fallback runs local Scikit-Learn models automatically)
# GEMINI_API_KEY="your-gemini-api-key-here"

